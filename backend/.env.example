# Copy to .env. Never commit the real .env file.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/fitfind
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Set to 1 only behind exactly one trusted reverse proxy; otherwise keep 0.
TRUST_PROXY_HOPS=0
# Relative paths resolve from the backend folder. Use a persistent disk in production.
JSON_DATA_DIR=./data/preferences
# Optional demonstration catalog. These are sample products, not live store offers.
ENABLE_EXTERNAL_PRODUCTS=false
