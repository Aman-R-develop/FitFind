{
  "name": "fitfind-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Beginner-friendly Express API and static frontend for FitFind",
  "main": "src/server.js",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:ui": "node --test test/browser.test.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "mongoose": "^8.19.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.2.0",
    "supertest": "^7.1.4"
  }
}
