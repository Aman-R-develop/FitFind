{
  "info": {
    "name": "FitFind API",
    "description": "Run in order against a development database. Creates a demo account, checks JSON persistence and MongoDB CRUD, then logs out. Created looks and favorites are deleted; the demo account and preferences remain. Optional external products return 503 when disabled and 502 if the provider is unavailable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-FitFind-Request",
            "value": "1"
          }
        ],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Register a new demo account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-FitFind-Request",
            "value": "1"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Student\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Creates an account and logs in. Generates a fresh example email for each run. Postman keeps the session cookie automatically. Use a development database."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('email', 'postman-' + pm.variables.replaceIn('{{$guid}}') + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status', function () { pm.expect(pm.response.code).to.be.oneOf([201]); });"
            ]
          }
        }
      ]
    },
